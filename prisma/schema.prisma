generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TransactionHistory {
  ref_id         String    @id
  username       String
  buyer_sku_code String
  customer_no    String
  sign           String
  customer_id    Int?
  status         String?
  profit         Int?
  createdBy      User?     @relation(fields: [userId], references: [id])
  userId         Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  customer       Customer? @relation(fields: [customer_id], references: [id])
}

model Customer {
  id                 Int                  @id @default(autoincrement())
  username           String
  balance            Int
  apiKey             String
  createdBy          User?                @relation(fields: [userId], references: [id])
  userId             Int?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  TransactionHistory TransactionHistory[]
}

model ProductPrice {
  id             Int      @id @default(autoincrement())
  brand          String
  category       String
  price          Int
  actualPrice    Int?
  buyer_sku_code String
  product_name   String
  createdBy      User?    @relation(fields: [userId], references: [id])
  userId         Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model Owner {
  id        Int      @id @default(autoincrement())
  name      String
  balance   Int
  createdBy User?    @relation(fields: [userId], references: [id])
  userId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String
  password  String
  role      Roles
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  Owner              Owner[]
  TransactionHistory TransactionHistory[]
  Customer           Customer[]
  ProductPrice       ProductPrice[]
}

enum Roles {
  Admin
  SuperAdmin
}
