generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TransactionHistory {
  ref_id            String       @id
  username          String
  buyer_sku_code    String
  customer_no       String
  sign              String
  customer_id       Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  profit            Int?
  status            String?
  createdBy         Int?
  item_price        Int?
  customer_username String?
  source            String?
  order_id          Int?
  user              User?        @relation(fields: [createdBy], references: [id])
  customer          Customer?    @relation(fields: [customer_id], references: [id])
  order             ItemkuOrder? @relation(fields: [order_id], references: [order_id])
}

model Customer {
  id                     Int                      @id @default(autoincrement())
  username               String
  balance                Int
  apiKey                 String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @default(now()) @updatedAt
  createdBy              Int?
  password               String?
  name                   String?
  user                   User?                    @relation(fields: [createdBy], references: [id])
  CustomerBalanceHistory CustomerBalanceHistory[]
  TransactionHistory     TransactionHistory[]
}

model ProductPrice {
  id             Int             @id @default(autoincrement())
  brand          String
  category       String
  price          Int
  buyer_sku_code String          @unique
  product_name   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  actualPrice    Int?
  createdBy      Int?
  ItemkuProduct  ItemkuProduct[]
  user           User?           @relation(fields: [createdBy], references: [id])
}

model Owner {
  id            Int      @id @default(autoincrement())
  name          String
  balance       Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  createdBy     Int?
  percentage    Int?
  percentageExt Int?
  user          User?    @relation(fields: [createdBy], references: [id])
}

model User {
  id                 Int                  @id @default(autoincrement())
  name               String
  role               Roles
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  password           String
  username           String
  Customer           Customer[]
  ItemkuProduct      ItemkuProduct[]
  Owner              Owner[]
  ProductPrice       ProductPrice[]
  TransactionHistory TransactionHistory[]
}

model CustomerBalanceHistory {
  id         Int                 @id @default(autoincrement())
  name       String
  username   String
  bf_balance Int
  af_balance Int
  amount     Int
  customerId Int
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt
  ref_id     String?
  type       CustomerBalanceType
  Customer   Customer            @relation(fields: [customerId], references: [id])
}

model ItemkuOrder {
  price                Int
  quantity             Int
  status               String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  delivery_info        String?
  delivery_info_field  String?
  game_name            String
  is_from_ads          Boolean              @default(false)
  order_id             Int                  @id @unique
  order_income         Int
  order_number         String               @unique
  product_id           Int
  product_name         String
  required_information Json
  using_delivery_info  Int                  @default(0)
  transactionHistory   TransactionHistory[]
}

model ItemkuProduct {
  item_id     Int           @id @unique
  game_name   String
  server_name String
  group_name  String
  min_order   Int
  price       Int
  product_id  Int?
  createdBy   Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  stock       Int
  item_name   String
  user        User?         @relation(fields: [createdBy], references: [id])
  product     ProductPrice? @relation(fields: [product_id], references: [id])
}

model ExternalUser {
  id                         Int                          @id @default(autoincrement())
  name                       String
  username                   String
  password                   String
  balance                    Int
  role                       Roles
  apiKey                     String?
  isCustomer                 Boolean
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @default(now()) @updatedAt
  externalAdminUsersUserId   Int?
  email                      String?
  phoneNumber                String?
  referalCode                String?                      @unique
  referalName                String?                      @unique
  ExternalAdminCustProduct   ExternalAdminCustProduct[]
  ExternalProduct            ExternalProduct[]
  ExternalSupplierProduct    ExternalSupplierProduct[]
  ExternalTransactionBatch   ExternalTransactionBatch[]
  ExternalTransactionHistory ExternalTransactionHistory[]
  ExternalUserBalanceHistory ExternalUserBalanceHistory[]
  asCustomer                 ExternalAdminUsers[]         @relation("CustomerRelation")
  asAdmin                    ExternalAdminUsers[]         @relation("AdminRelation")
}

model ExternalAdminUsers {
  cust_id   Int
  admin_id  Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  customer  ExternalUser @relation("CustomerRelation", fields: [cust_id], references: [id])
  admin     ExternalUser @relation("AdminRelation", fields: [admin_id], references: [id])

  @@id([cust_id, admin_id])
}

model ExternalUserBalanceHistory {
  id           Int                 @id @default(autoincrement())
  name         String
  username     String
  type         CustomerBalanceType
  bf_balance   Int
  af_balance   Int
  amount       Int
  ref_id       String
  userId       Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  ExternalUser ExternalUser        @relation(fields: [userId], references: [id])
}

model ExternalTransactionBatch {
  batch_id    String                       @id
  createdBy   Int?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @default(now()) @updatedAt
  user        ExternalUser?                @relation(fields: [createdBy], references: [id])
  transaction ExternalTransactionHistory[]
}

model ExternalTransactionHistory {
  ref_id                           String                    @id
  username                         String
  buyer_sku_code                   String
  customer_no                      String
  sign                             String
  customer_id                      Int?
  status                           String?
  customer_username                String?
  source                           String?
  item_price                       Int?
  profit                           Int?
  createdBy                        Int?
  createdAt                        DateTime                  @default(now())
  updatedAt                        DateTime                  @default(now()) @updatedAt
  order_id                         Int?
  externalTransactionBatchBatch_id String?
  rc                               String
  sn                               String
  user                             ExternalUser?             @relation(fields: [createdBy], references: [id])
  ExternalTransactionBatch         ExternalTransactionBatch? @relation(fields: [externalTransactionBatchBatch_id], references: [batch_id])
}

model ExternalProduct {
  item_id                  String                         @id @unique
  game_name                String
  item_name                String
  server_name              String
  group_name               String
  stock                    Int
  min_order                Int
  price                    Int
  createdBy                Int?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @default(now()) @updatedAt
  admin_price              Int?
  products                 ExtProductToSupplierJunction[]
  ExternalAdminCustProduct ExternalAdminCustProduct[]
  user                     ExternalUser?                  @relation(fields: [createdBy], references: [id])
}

model ExternalSupplierProduct {
  id                           Int                            @id @default(autoincrement())
  brand                        String
  category                     String
  price                        Int
  actualPrice                  Int?
  createdBy                    Int?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @default(now()) @updatedAt
  code                         String                         @unique
  desc                         String
  end_cut_off                  String
  multi                        Boolean
  start_cut_off                String
  status                       Boolean
  unlimited_stock              Boolean
  name                         String
  type                         String
  stock                        Int
  ExtProductToSupplierJunction ExtProductToSupplierJunction[]
  user                         ExternalUser?                  @relation(fields: [createdBy], references: [id])
}

model ExtProductToSupplierJunction {
  product_id Int
  item_id    String
  qty        Int
  extProduct ExternalProduct         @relation(fields: [item_id], references: [item_id])
  product    ExternalSupplierProduct @relation(fields: [product_id], references: [id])

  @@id([product_id, item_id])
}

model ExternalAdminCustProduct {
  cust_id    Int
  item_id    String
  price      Int
  createdBy  Int?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now()) @updatedAt
  customer   ExternalUser    @relation(fields: [cust_id], references: [id])
  extProduct ExternalProduct @relation(fields: [item_id], references: [item_id])

  @@id([cust_id, item_id])
}

enum Roles {
  Admin
  SuperAdmin
  Customer
}

enum CustomerBalanceType {
  Withdrawal
  Deposit
  Transaction
}
