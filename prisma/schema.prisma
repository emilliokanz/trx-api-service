generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TransactionHistory {
  ref_id            String    @id
  username          String
  buyer_sku_code    String
  customer_no       String
  sign              String
  customer_id       Int?
  status            String?
  customer_username String?
  item_price        Int?
  profit            Int?
  user              User?     @relation(fields: [createdBy], references: [id])
  createdBy         Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  customer          Customer? @relation(fields: [customer_id], references: [id])
}

model Customer {
  id        Int      @id @default(autoincrement())
  username  String
  balance   Int
  apiKey    String
  user      User?    @relation(fields: [createdBy], references: [id])
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  TransactionHistory     TransactionHistory[]
  CustomerBalanceHistory CustomerBalanceHistory[]
}

model ProductPrice {
  id             Int      @id @default(autoincrement())
  brand          String
  category       String
  price          Int
  actualPrice    Int?
  buyer_sku_code String
  product_name   String
  user           User?    @relation(fields: [createdBy], references: [id])
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model Owner {
  id        Int      @id @default(autoincrement())
  name      String
  balance   Int
  user      User?    @relation(fields: [createdBy], references: [id])
  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String
  password  String
  role      Roles
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  Owner              Owner[]
  TransactionHistory TransactionHistory[]
  Customer           Customer[]
  ProductPrice       ProductPrice[]
}

model CustomerBalanceHistory {
  id         Int                    @id @default(autoincrement())
  name       String
  username   String
  type       CustomerBalanceType
  bf_balance Int
  af_balance Int
  amount     Int
  ref_id     String?
  Customer   Customer?              @relation(fields: [customerId], references: [id])
  customerId Int
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @default(now()) @updatedAt
}

enum Roles {
  Admin
  SuperAdmin
}

enum CustomerBalanceType {
  Withdrawal
  Deposit
  Transaction
}
