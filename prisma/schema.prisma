generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TransactionHistory {
  ref_id         String    @id
  username       String
  buyer_sku_code String
  customer_no    String
  sign           String
  customer       Customer? @relation(fields: [customer_id], references: [id])
  customer_id    Int?
  status         String?
  profit         Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model Customer {
  id                 Int                  @id @default(autoincrement())
  username           String
  balance            Int
  apiKey             String
  TransactionHistory TransactionHistory[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
}

model ProductPrice {
  id             Int      @id @default(autoincrement())
  brand          String
  category       String
  price          Int
  buyer_sku_code String
  product_name   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model Owner {
  id        Int      @id @default(autoincrement())
  name      String
  balance   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
